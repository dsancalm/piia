---
import Press from './Press.astro';

interface Props {
  lang: 'es' | 'en';
  altHref: string;
}

const { lang, altHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = {
  es: {
    tagline: 'Lo que ha cambiado hoy en IA, y por qué te afecta',
    home: 'Portada',
    about: 'Qué es esto',
    switch: 'Read in English',
  },
  en: {
    tagline: "What changed in AI today, and why it matters to you",
    home: 'Front page',
    about: 'What is this',
    switch: 'Leer en español',
  },
}[lang];
---

<header class="masthead">
  <div class="wrap bar">
    <a class="brand" href={`${base}/${lang}/`}>
      <Press />
      <span class="wordmark hl">PIIA</span>
    </a>

    <p class="tagline">{t.tagline}</p>

    <nav aria-label={t.home}>
      <a href={`${base}/${lang}/`}>{t.home}</a>
      <a href={`${base}/${lang}/about/`}>{t.about}</a>
      <a class="lang" href={`${base}${altHref}`} lang={lang === 'es' ? 'en' : 'es'}>{t.switch}</a>
    </nav>
  </div>

  <!-- El filo de la fotocopia: un borde de tinta que nunca sale recto. -->
  <svg class="rule" viewBox="0 0 1200 9" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 5.2 C 90 2.1, 180 7.4, 268 4.3 S 448 6.9, 540 3.6 S 726 7.2, 812 4.1 S 998 6.4, 1090 3.9 L 1200 5"
      fill="none"
      stroke="#111"
      stroke-width="3"
      stroke-linecap="round"
    />
  </svg>
</header>

<style>
  .masthead {
    padding-top: var(--s3);
  }

  .bar {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    flex-wrap: wrap;
    padding-bottom: var(--s2);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--marker);
    font-size: clamp(2rem, 5vw, 2.9rem);
    line-height: 1;
    padding: 0 0.16em;
  }

  .tagline {
    flex: 1 1 16rem;
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
    max-width: 34ch;
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--s3);
    font-size: 0.95rem;
    font-weight: 600;
  }

  nav a {
    text-decoration: none;
    padding-bottom: 2px;
  }

  nav a:hover {
    background-image: linear-gradient(transparent 72%, var(--hl-teal) 72%);
  }

  .lang {
    font-style: italic;
    color: var(--ink-soft);
  }

  .rule {
    display: block;
    width: 100%;
    height: 9px;
  }

  @media (max-width: 40rem) {
    .tagline {
      order: 3;
      flex-basis: 100%;
    }
  }
</style>
