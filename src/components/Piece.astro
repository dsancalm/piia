---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Stamp from './Stamp.astro';

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, lang, story, publishedAt, sourceUrl, sourceName, priority, generatedBy } =
  entry.data;

// Anterior y siguiente dentro del mismo idioma, por fecha: el lector diario
// puede hojear el cable sin volver a la portada.
const siblings = (await getCollection('news', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const idx = siblings.findIndex((e) => e.data.story === story);
const newer = idx > 0 ? siblings[idx - 1] : null;
const olderPiece = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : null;

const t = {
  es: {
    origin: 'Procedencia',
    source: 'Fuente original',
    written: 'Redactado por',
    disclosure:
      'Este texto lo ha escrito una máquina a partir de la fuente enlazada. Nadie lo ha revisado antes de publicarlo.',
    back: 'Volver a la portada',
    pager: 'Otras noticias',
    newer: 'Más reciente',
    older: 'Anterior',
  },
  en: {
    origin: 'Provenance',
    source: 'Original source',
    written: 'Written by',
    disclosure:
      'This text was written by a machine from the linked source. Nobody reviewed it before publishing.',
    back: 'Back to the front page',
    pager: 'Other stories',
    newer: 'Newer',
    older: 'Older',
  },
}[lang];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = publishedAt.toLocaleDateString(lang, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Madrid',
});
---

<Base
  lang={lang}
  title={`${title} — PIIA`}
  description={summary}
  altHref={`/${lang === 'es' ? 'en' : 'es'}/${story}/`}
>
  <article class="wrap piece">
    <header>
      <div class="meta">
        <Stamp priority={priority} lang={lang} />
        <time datetime={publishedAt.toISOString()}>{date}</time>
      </div>
      <h1 style={`view-transition-name: d-${story};`}>{title}</h1>
      <p class="lede">{summary}</p>
    </header>

    <!-- La procedencia va antes del texto, no escondida al final. -->
    <aside class="origin" aria-label={t.origin}>
      <p class="origin-head">{t.origin}</p>
      <p class="disclosure">{t.disclosure}</p>
      <p class="links">
        <a class="src" href={sourceUrl} rel="noopener">{t.source}: {sourceName}</a>
        <span class="by">
          {t.written}{' '}
          <code translate="no">
            {generatedBy.split('/').map((part: string, i: number) => (
              <>
                {i > 0 && <>/<wbr /></>}
                {part}
              </>
            ))}
          </code>
        </span>
      </p>
    </aside>

    <div class="prose">
      <Content />
    </div>

    <a class="back" href={`${base}/${lang}/`}>← {t.back}</a>

    {
      (newer || olderPiece) && (
        <nav class="pager" aria-label={t.pager}>
          {newer && (
            <a class="page newer" href={`${base}/${lang}/${newer.data.story}/`}>
              <span class="page-label service">← {t.newer}</span>
              <span class="page-title">{newer.data.title}</span>
            </a>
          )}
          {olderPiece && (
            <a class="page older" href={`${base}/${lang}/${olderPiece.data.story}/`}>
              <span class="page-label service">{t.older} →</span>
              <span class="page-title">{olderPiece.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>

<script>
  // Botón de copiar en cada bloque de código: la interacción más útil del
  // producto. El DOM lo crea este script para que el HTML siga funcionando
  // íntegro sin JavaScript.
  const es = document.documentElement.lang === 'es';
  const labels = {
    copy: es ? 'Copiar' : 'Copy',
    done: es ? 'Copiado' : 'Copied',
    fail: es ? 'No se pudo copiar' : 'Copy failed',
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy';
    btn.textContent = labels.copy;
    btn.setAttribute('aria-live', 'polite');
    wrap.appendChild(btn);

    let timer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        btn.textContent = labels.done;
        btn.classList.add('done');
      } catch {
        btn.textContent = labels.fail;
      }
      clearTimeout(timer);
      timer = setTimeout(() => {
        btn.textContent = labels.copy;
        btn.classList.remove('done');
      }, 1800);
    });
  }
</script>

<style>
  .piece {
    padding-top: var(--s4);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s3);
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.025em;
    max-width: 24ch;
    margin-bottom: var(--s3);
  }

  .lede {
    font-size: 1.2rem;
    line-height: 1.55;
    max-width: 52ch;
    color: var(--ink-soft);
    margin: 0 0 var(--s4);
  }

  /* El recuadro de procedencia: la ficha de rutado del despacho, con la regla
     gruesa del servicio arriba. */
  .origin {
    max-width: var(--measure);
    margin-bottom: var(--s4);
    padding: var(--s3);
    background: var(--paper-deep);
    border-top: 3px solid var(--ink);
  }

  .origin-head {
    font-family: var(--display);
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wire-red);
    margin: 0 0 var(--s1);
  }

  .disclosure {
    margin: 0 0 var(--s2);
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) var(--s3);
    margin: 0;
    font-size: 0.9rem;
  }

  .src {
    font-family: var(--display);
    font-weight: 600;
    text-underline-offset: 4px;
    /* Área táctil ≥44px; como flex item, el padding también estira la fila. */
    padding-block: 0.85em;
  }

  .src:hover {
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
  }

  .by {
    color: var(--ink-soft);
  }

  .by code {
    font-family: var(--mono);
    font-size: 0.85em;
  }

  .prose {
    max-width: var(--measure);
    /* Los artículos citan URLs enteras como texto de enlace; sin esto, una URL
       larga revienta el ancho en móvil. */
    overflow-wrap: break-word;
  }

  /* Cada sección abre con su regla de cable: hairline hasta el margen. */
  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: var(--s5);
    margin-bottom: var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--rule);
  }

  .prose :global(p) {
    margin-block: 0 var(--s3);
  }

  .prose :global(a) {
    font-weight: 600;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
  }

  .prose :global(ol),
  .prose :global(ul) {
    padding-left: 1.3em;
    margin-block: 0 var(--s3);
  }

  .prose :global(li) {
    margin-bottom: var(--s1);
  }

  /* El bloque de código es el objeto central del servicio: lo que el lector
     va a copiar y pegar en su terminal. Se mantiene oscuro a propósito. */
  .prose :global(pre) {
    margin-block: var(--s3) var(--s4);
    padding: var(--s3);
    border: 0;
    border-radius: 4px;
    /* Shiki escribe el fondo en un atributo `style` sobre el propio <pre>, y un
       estilo en línea solo se puede sobrescribir con !important. */
    background-color: #14171a !important;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    /* Señal de contenido desplazable: una sombra clara fija en el filo derecho
       y una capa del color del bloque que viaja con el contenido y la tapa al
       llegar al final. */
    background-image:
      linear-gradient(to left, #14171a 30%, rgba(20, 23, 26, 0)),
      linear-gradient(to left, rgba(252, 252, 250, 0.35), rgba(252, 252, 250, 0) 85%);
    background-repeat: no-repeat, no-repeat;
    background-position: right center, right center;
    background-size: 1.75rem 100%, 2rem 100%;
    background-attachment: local, scroll;
  }

  .prose :global(pre:focus-visible) {
    outline-offset: 3px;
  }

  .prose :global(pre code) {
    font-family: var(--mono);
  }

  /* Los bloques `text` son prompts en lenguaje natural, no comandos: se
     envuelven en vez de cortarse con scroll. El código real conserva el
     desplazamiento para no romper líneas copiables. */
  .prose :global(pre[data-language='text']) {
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  /* Código dentro de prosa: marcado, no encajonado. */
  .prose :global(:not(pre) > code) {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--paper-deep);
    padding: 0.15em 0.35em;
    border-radius: 3px;
    border: 1px solid var(--rule);
  }

  .back {
    display: inline-block;
    margin-top: var(--s5);
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    /* Área táctil ≥44px. */
    padding-block: 0.75em;
    margin-block: calc(var(--s5) - 0.75em) -0.75em;
  }

  .back:hover {
    text-decoration: underline;
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* Hojear el cable: despacho anterior y siguiente bajo su regla. */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s3);
    margin-top: var(--s4);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .page {
    display: grid;
    gap: var(--s1);
    text-decoration: none;
    align-content: start;
    /* Área táctil ≥44px. */
    padding-block: 0.5em;
  }

  .page.older {
    grid-column: 2;
    text-align: right;
    justify-items: end;
  }

  .page-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
  }

  .page:visited .page-title {
    color: var(--ink-soft);
  }

  .page:hover .page-title,
  .page:focus-visible .page-title {
    text-decoration: underline;
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* El botón de copiar: pieza de servicio sobre el bloque, con área ≥44px. */
  .prose :global(.code-wrap) {
    position: relative;
    margin-block: var(--s3) var(--s4);
  }

  .prose :global(.code-wrap pre) {
    margin-block: 0;
  }

  .prose :global(.copy) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.5em 0.9em;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--ink);
    border-radius: 3px;
    cursor: pointer;
  }

  .prose :global(.copy:hover) {
    background: var(--paper-deep);
  }

  .prose :global(.copy.done) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* El recorte de procedencia se pega al margen derecho en pantallas anchas:
     la marginalia del pliego. En columna única vuelve a su sitio, antes del
     texto. */
  @media (min-width: 72rem) {
    .piece {
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(16rem, 21rem);
      column-gap: var(--s5);
      align-items: start;
    }

    .piece > header {
      grid-column: 1;
      grid-row: 1;
    }

    .origin {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      top: var(--s4);
      margin-bottom: 0;
    }

    .prose {
      grid-column: 1;
      grid-row: 2;
    }

    .back {
      grid-column: 1;
      grid-row: 3;
    }

    .pager {
      grid-column: 1;
      grid-row: 4;
    }
  }
</style>
