---
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = {
  es: {
    what: 'PIIA lo escribe una máquina.',
    body:
      'Un agente lee las fuentes cada día, investiga contra el material original y redacta cada noticia. Nadie lo revisa antes de publicarlo. Cuando algo esté mal, lo estará con su enlace al lado para que puedas comprobarlo.',
    source: 'Código y fuentes',
  },
  en: {
    what: 'PIIA is written by a machine.',
    body:
      'An agent reads the sources each day, researches against the original material and writes every story. Nobody reviews it before it goes out. When something is wrong, it will be wrong with its link right next to it so you can check.',
    source: 'Code and sources',
  },
}[lang];
---

<footer>
  <!-- La regla doble del pie: fina sobre gruesa, espejo de la cabecera. -->
  <div class="rules" aria-hidden="true"></div>

  <div class="wrap inner">
    <p class="what">{t.what}</p>
    <p class="body">{t.body}</p>
    <p class="links">
      <a class="repo" href="https://github.com/dsancalm/piia">{t.source}</a>
      <a class="repo" href={`${base}/${lang}/rss.xml`} translate="no">RSS</a>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--s6);
    padding-bottom: var(--s5);
  }

  .rules {
    border-top: 1px solid var(--ink);
    border-bottom: 3px solid var(--ink);
    height: 6px;
  }

  .inner {
    padding-top: var(--s3);
  }

  .what {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
    margin: 0 0 var(--s1);
  }

  .body {
    margin: 0 0 var(--s3);
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    gap: var(--s3);
    margin: 0;
  }

  .repo {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    /* Área táctil ≥44px. */
    padding-block: 0.75em;
    margin-block: -0.75em;
  }

  .repo:hover {
    text-decoration: underline;
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
</style>
