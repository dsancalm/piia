---
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const t = {
  es: {
    what: 'PIIA lo escribe una máquina.',
    body:
      'Un agente lee las fuentes cada día, investiga contra el material original y redacta cada despacho. Nadie lo revisa antes de publicarlo. Cuando algo esté mal, lo estará con su enlace al lado para que puedas comprobarlo.',
    source: 'Código y fuentes',
  },
  en: {
    what: 'PIIA is written by a machine.',
    body:
      'An agent reads the sources each day, researches against the original material and writes every dispatch. Nobody reviews it before it goes out. When something is wrong, it will be wrong with its link right next to it so you can check.',
    source: 'Code and sources',
  },
}[lang];
---

<footer>
  <svg class="rule" viewBox="0 0 1200 9" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M0 4.4 C 96 7.1, 190 2.6, 280 5.4 S 470 3.1, 566 6.2 S 742 2.8, 836 5.6 S 1020 3.2, 1116 6.1 L 1200 4.4"
      fill="none"
      stroke="#111"
      stroke-width="3"
      stroke-linecap="round"
    />
  </svg>

  <div class="wrap inner">
    <p class="what">{t.what}</p>
    <p class="body">{t.body}</p>
    <p class="links">
      <a class="repo" href="https://github.com/dsancalm/piia">{t.source}</a>
      <a class="repo" href={`${base}/${lang}/rss.xml`} translate="no">RSS</a>
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--s6);
    padding-bottom: var(--s5);
  }

  .rule {
    display: block;
    width: 100%;
    height: 9px;
  }

  .inner {
    padding-top: var(--s3);
  }

  .what {
    font-family: var(--marker);
    font-size: 1.35rem;
    margin: 0 0 var(--s1);
  }

  .body {
    margin: 0 0 var(--s3);
    max-width: 58ch;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .links {
    display: flex;
    gap: var(--s3);
    margin: 0;
  }

  .repo {
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* Hover de enlace de navegación: siempre el marcador amarillo. El rosa se
     reserva para procedencia y el teal para el halo de foco. */
  .repo:hover {
    background-image: linear-gradient(transparent 72%, var(--hl-yellow-mark) 72%);
  }
</style>
