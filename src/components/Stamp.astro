---
// Etiqueta de prioridad del despacho: la escalera del teletipo. La palabra
// lleva el significado; el rojo solo refuerza la urgencia.
interface Props {
  priority: 'flash' | 'urgent' | 'routine';
  lang: 'es' | 'en';
}

const { priority, lang } = Astro.props;

const label = {
  es: { flash: 'Última hora', urgent: 'Importante', routine: 'Del día' },
  en: { flash: 'Breaking', urgent: 'Important', routine: 'Today' },
}[lang][priority];

const kind = { flash: 'tag-solid', urgent: 'tag-outline', routine: 'tag-plain' }[priority];
---

<span class:list={['tag', kind]}>{label}</span>
