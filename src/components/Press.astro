---
// El operario de la imprenta: un rodillo entintador con ojos. No vende simpatía
// ni celebra nada; es la firma de que aquí dentro hay una máquina imprimiendo.
// Geometría exacta con trazo de rotulador, sin sombreado ni perspectiva.
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---

<svg
  class="press"
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="#111"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Cuerpo del rodillo -->
  <rect x="7" y="9" width="26" height="18" rx="4" fill="#fff8ec" />
  <!-- Ojos: el testigo de que la máquina está mirando la fuente -->
  <circle cx="16" cy="17" r="2.6" fill="#111" stroke="none" />
  <circle cx="26" cy="17" r="2.6" fill="#111" stroke="none" />
  <!-- Mango -->
  <path d="M20 9 V4" />
  <path d="M15.5 4 H24.5" />
  <!-- Tinta saliendo: tres trazos que caen -->
  <path d="M12 30 V34" stroke="#ff6bae" />
  <path d="M20 30 V36" stroke="#00c7b7" />
  <path d="M28 30 V33" stroke="#ffe34d" />
</svg>

<style>
  .press {
    flex: none;
  }
</style>
