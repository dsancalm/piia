---
import Stamp from './Stamp.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      story: string;
      publishedAt: Date;
      sourceUrl: string;
      sourceName: string;
      priority: 'flash' | 'urgent' | 'routine';
      tags: string[];
    };
  };
  lang: 'es' | 'en';
  /** El primero del día abre el servicio a tamaño de cabeza de portada. */
  lead?: boolean;
}

const { entry, lang, lead = false } = Astro.props;
const { title, summary, story, publishedAt, sourceUrl, sourceName, priority, tags } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// El despacho de cabeza es el contenido principal de la página: su titular es
// el h1. El resto de la pila vive dentro de la sección "También hoy" (h2), así
// que sus titulares son h3.
const Heading = lead ? 'h1' : 'h3';

const t = {
  es: { source: 'Fuente' },
  en: { source: 'Source' },
}[lang];

// TZ fija: sin ella, la hora impresa dependería del TZ del runner de CI.
const time = publishedAt.toLocaleTimeString(lang, {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Madrid',
});
---

<article class:list={['dispatch', { lead }]}>
  <div class="meta">
    <Stamp priority={priority} lang={lang} />
    <time datetime={publishedAt.toISOString()}>{time}</time>
  </div>

  <Heading style={`view-transition-name: d-${story};`}>
    <a href={`${base}/${lang}/${story}/`}>{title}</a>
  </Heading>

  <p class="summary">{summary}</p>

  <div class="foot">
    <a class="source" href={sourceUrl} rel="noopener">
      {t.source}: {sourceName}
    </a>
    {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
  </div>
</article>

<style>
  .dispatch {
    padding-block: var(--s3);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s2);
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  :is(h1, h3) {
    font-size: 1.25rem;
    line-height: 1.3;
    margin-bottom: var(--s2);
  }

  :is(h1, h3) a {
    text-decoration: none;
    /* Padding en inline: agranda el área táctil a ≥44px sin tocar el line box. */
    padding-block: 0.55em;
  }

  :is(h1, h3) a:hover,
  :is(h1, h3) a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
  }

  /* El lector diario distingue lo que ya leyó: la tinta del titular visitado
     baja a la secundaria. Solo en el índice; la cabeza del día siempre imprime
     a tinta plena. */
  .dispatch:not(.lead) :is(h1, h3) a:visited {
    color: var(--ink-soft);
  }

  .summary {
    margin: 0 0 var(--s2);
    max-width: var(--measure);
    color: var(--ink-soft);
    overflow-wrap: break-word;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
  }

  /* La procedencia es parte del contenido: siempre visible, siempre subrayada
     como enlace. */
  .source {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.85rem;
    text-underline-offset: 4px;
    /* Área táctil ≥44px; como flex item, el padding también estira la fila. */
    padding-block: 0.95em;
  }

  .source:hover {
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
  }

  .tags {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  /* La cabeza del servicio: el titular que se lee desde la otra punta de la
     mesa, en peso de portada. */
  .lead :is(h1, h3) {
    font-size: clamp(2.1rem, 4.6vw, 3.4rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .lead .summary {
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 52ch;
  }
</style>
