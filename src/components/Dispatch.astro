---
import Stamp from './Stamp.astro';

interface Props {
  entry: {
    id: string;
    data: {
      title: string;
      summary: string;
      story: string;
      publishedAt: Date;
      sourceUrl: string;
      sourceName: string;
      priority: 'flash' | 'urgent' | 'routine';
      tags: string[];
    };
  };
  lang: 'es' | 'en';
  /** El primero del día se imprime a tamaño de cartel. */
  lead?: boolean;
}

const { entry, lang, lead = false } = Astro.props;
const { title, summary, story, publishedAt, sourceUrl, sourceName, priority, tags } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// El despacho de portada es el contenido principal de la página: su titular es
// el h1. El resto de la pila vive dentro de la sección "También hoy" (h2), así
// que sus titulares son h3.
const Heading = lead ? 'h1' : 'h3';

const t = {
  es: { source: 'Fuente', read: 'Leer el despacho' },
  en: { source: 'Source', read: 'Read the dispatch' },
}[lang];

// TZ fija: sin ella, la hora impresa dependería del TZ del runner de CI.
const time = publishedAt.toLocaleTimeString(lang, {
  hour: '2-digit',
  minute: '2-digit',
  timeZone: 'Europe/Madrid',
});
---

<article class:list={['dispatch', { lead }]}>
  <div class="meta">
    <Stamp priority={priority} lang={lang} />
    <time datetime={publishedAt.toISOString()}>{time}</time>
  </div>

  <Heading style={`view-transition-name: d-${story};`}>
    <a href={`${base}/${lang}/${story}/`}>{title}</a>
  </Heading>

  <p class="summary">{summary}</p>

  <div class="foot">
    <a class="source hl hl-pink" href={sourceUrl} rel="noopener nofollow">
      {t.source}: {sourceName}
    </a>
    {tags.length > 0 && <p class="tags">{tags.join(' · ')}</p>}
  </div>
</article>

<style>
  .dispatch {
    padding-block: var(--s3);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s2);
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  :is(h1, h3) {
    font-size: 1.45rem;
    margin-bottom: var(--s2);
    text-wrap: balance;
  }

  :is(h1, h3) a {
    text-decoration: none;
    /* El titular se subraya al pasar, como quien marca el artículo que va a leer. */
    background-image: linear-gradient(transparent 88%, var(--hl-yellow) 88%);
    background-size: 0% 100%;
    background-repeat: no-repeat;
    transition: background-size 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :is(h1, h3) a:hover,
  :is(h1, h3) a:focus-visible {
    background-size: 100% 100%;
  }

  /* Al pasar por el despacho, el sello se recoloca un pelín: el tampón aún
     está fresco. La inclinación base viene de --tilt en el propio sello. */
  .dispatch:hover :global(.stamp) {
    transform: rotate(calc(var(--tilt, 0deg) + 1.3deg)) scale(1.05);
  }

  .summary {
    margin: 0 0 var(--s3);
    max-width: var(--measure);
    color: var(--ink-soft);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    font-size: 0.85rem;
  }

  /* La procedencia va marcada en rosa: es el color que en este zine significa
     "de dónde salió esto". El subrayado de tinta se queda porque la banda sola
     no llega al contraste mínimo para señalar un enlace. */
  .source {
    font-weight: 600;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  /* Las etiquetas no son código ni medida, así que no van en monoespaciado: eso
     es disfraz técnico, justo lo que este mundo rechaza. */
  .tags {
    margin: 0;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  /* El despacho de portada: el que se lee desde la otra punta de la mesa. */
  .lead :is(h1, h3) {
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    line-height: 0.98;
  }

  .lead .summary {
    font-size: 1.2rem;
    max-width: 46ch;
  }
</style>
