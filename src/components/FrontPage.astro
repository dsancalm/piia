---
import { getCollection } from 'astro:content';
import Dispatch from './Dispatch.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const all = await getCollection('news', ({ data }) => data.lang === lang);
const dispatches = all.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const [lead, ...rest] = dispatches;

// El servicio solo contiene los despachos de su propio día; lo anterior baja al
// archivo. Sin este corte, "Servicio del [fecha]" mentiría en cuanto convivieran
// dos tiradas, y el índice crecería sin límite.
const dayKey = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/Madrid' });
const issueKey = lead ? dayKey(lead.data.publishedAt) : '';
const rail = rest.filter((e) => dayKey(e.data.publishedAt) === issueKey);
const older = rest.filter((e) => dayKey(e.data.publishedAt) !== issueKey);

const byDay = new Map<string, typeof older>();
for (const e of older) {
  const k = dayKey(e.data.publishedAt);
  if (!byDay.has(k)) byDay.set(k, []);
  byDay.get(k)!.push(e);
}

const dateOpts = {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Europe/Madrid',
} as const;
const issueDate = lead ? lead.data.publishedAt.toLocaleDateString(lang, dateOpts) : '';
const issueCount = lead ? 1 + rail.length : 0;
const dayLabel = (e: (typeof older)[number]) => e.data.publishedAt.toLocaleDateString(lang, dateOpts);
const timeLabel = (e: (typeof older)[number]) =>
  e.data.publishedAt.toLocaleTimeString(lang, {
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Europe/Madrid',
  });

const t = {
  es: {
    issue: 'Edición del',
    dispatches: ['noticia', 'noticias'],
    empty: 'Todavía no ha entrado nada',
    emptyBody:
      'El agente publica cada mañana. Si esto sigue vacío, es que ha fallado la publicación de hoy.',
    rest: 'También hoy',
    archive: 'Noticias anteriores',
  },
  en: {
    issue: 'Edition of',
    dispatches: ['story', 'stories'],
    empty: 'Nothing has come in yet',
    emptyBody: "The agent publishes every morning. If this stays empty, today's run failed.",
    rest: 'Also today',
    archive: 'Earlier stories',
  },
}[lang];
---

<div class="wrap">
  {
    lead ? (
      <>
        <p class="issue service">
          {t.issue} {issueDate} · {issueCount}{' '}
          {issueCount === 1 ? t.dispatches[0] : t.dispatches[1]}
        </p>

        <div class="sheet">
          <div class="lead-col">
            <Dispatch entry={lead} lang={lang} lead />
          </div>

          {rail.length > 0 && (
            <section class="rest" aria-labelledby="rest-title">
              <h2 id="rest-title" class="wirehead">{t.rest}</h2>
              <div class="stack">
                {rail.map((entry) => (
                  <Dispatch entry={entry} lang={lang} />
                ))}
              </div>
            </section>
          )}
        </div>

        {byDay.size > 0 && (
          <section class="archive" aria-labelledby="archive-title">
            <h2 id="archive-title" class="wirehead">{t.archive}</h2>
            {[...byDay.values()].map((entries) => (
              <section class="day">
                <h3 class="day-date service">{dayLabel(entries[0])}</h3>
                <ul class="day-list">
                  {entries.map((e) => (
                    <li>
                      <a href={`${base}/${lang}/${e.data.story}/`}>{e.data.title}</a>
                      <time class="when" datetime={e.data.publishedAt.toISOString()}>
                        {timeLabel(e)}
                      </time>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        )}
      </>
    ) : (
      <section class="empty">
        <h1>{t.empty}</h1>
        <p>{t.emptyBody}</p>
      </section>
    )
  }
</div>

<style>
  .issue {
    margin: var(--s4) 0 var(--s2);
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--rule);
  }

  .rest {
    margin-top: var(--s5);
  }

  .stack {
    display: grid;
  }

  .stack > :global(.dispatch) + :global(.dispatch) {
    border-top: 1px solid var(--rule);
  }

  /* El índice es un índice, no una segunda lectura: la entradilla se corta a
     dos líneas y las etiquetas se quedan para el despacho abierto. */
  .stack :global(.dispatch .summary) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--s2);
    font-size: 0.95rem;
  }

  .stack :global(.dispatch .tags) {
    display: none;
  }

  .empty {
    padding: var(--s6) 0;
    max-width: 46ch;
  }

  .empty h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: var(--s2);
  }

  .empty p {
    color: var(--ink-soft);
  }

  /* El archivo del cable: tiradas anteriores agrupadas por día, en filas de
     índice con su hora tabulada. */
  .archive {
    margin-top: var(--s6);
  }

  .day {
    /* El archivo crece un día cada día: no puede costar render completo en
       cada carga. */
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
  }

  .day + .day {
    margin-top: var(--s4);
  }

  .day-date {
    margin: var(--s3) 0 var(--s1);
  }

  .day-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .day-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
  }

  .day-list li + li {
    border-top: 1px solid var(--rule);
  }

  .day-list a {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.4;
    text-decoration: none;
    /* Área táctil ≥44px sin engordar la fila en vista de ratón. */
    padding-block: 0.75em;
  }

  .day-list a:visited {
    color: var(--ink-soft);
  }

  .day-list a:hover,
  .day-list a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--wire-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .when {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  /* La pila del día va al lado del despacho de cabeza, no debajo: sin esto, la
     mitad derecha de la pantalla queda vacía y el lector no ve un segundo
     titular sin hacer scroll. */
  @media (min-width: 64rem) {
    .sheet {
      display: grid;
      grid-template-columns: minmax(0, 1.85fr) minmax(17rem, 1fr);
      gap: var(--s5);
      align-items: start;
    }

    /* La cabeza acompaña al lector mientras recorre el índice: sin esto, la
       columna ancha queda vacía desde el segundo viewport. */
    .lead-col {
      position: sticky;
      top: var(--s4);
    }

    .rest {
      margin-top: 0;
      padding-left: var(--s3);
      border-left: 1px solid var(--rule);
    }

    .stack :global(.dispatch h3) {
      font-size: 1.1rem;
    }

    .stack :global(.dispatch .summary) {
      font-size: 0.9rem;
    }
  }

  /* El cable entra: la tirada del día asoma una vez por carga, cabeza primero
     y el índice detrás, escalonado. Solo para quien no pide movimiento
     reducido; el resto ve el estado final. */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes wire-in {
      from {
        opacity: 0;
        transform: translateY(6px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }

    .issue,
    .lead-col,
    .rest {
      animation: wire-in 320ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    }

    .lead-col {
      animation-delay: 60ms;
    }

    .rest {
      animation-delay: 140ms;
    }
  }
</style>
