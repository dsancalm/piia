---
// GitHub Pages no tiene servidor, así que la raíz redirige por meta refresh.
// El enlace visible cubre el caso de que el refresh no dispare.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const target = `${base}/es/`;
const canonical = new URL(target, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PIIA</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href={target}>Ir a la portada de PIIA</a>
  </body>
</html>
