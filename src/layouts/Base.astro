---
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
// Vite resuelve la misma URL con hash que usa el CSS de @fontsource, así el
// preload y la hoja de estilos apuntan al mismo archivo.
import franklinWoff2 from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import literataWoff2 from '@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang: 'es' | 'en';
  /** Ruta equivalente en el otro idioma, para el conmutador. */
  altHref: string;
}

const { title, description, lang, altHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const altLang = lang === 'es' ? 'en' : 'es';
const t = {
  es: { skip: 'Saltar al contenido' },
  en: { skip: 'Skip to content' },
}[lang];
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={altLang} href={new URL(`${base}${altHref}`, Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(lang === 'es' ? Astro.url.pathname : `${base}${altHref}`, Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="PIIA"
      href={`${base}/${lang}/rss.xml`}
    />
    <meta name="theme-color" content="#FCFCFA" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={franklinWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={literataWoff2} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <!--
      THESIS: El servicio de cable de una agencia automática: despachos con
      prioridad, hora y procedencia en jerarquía de sala de redacción. Rechaza
      la retícula de tarjetas oscuras con neón de los blogs de IA y el papel
      craft con letra dibujada del zine anterior.
      OWN-WORLD: Papel de servicio #FCFCFA, tinta #15181B, un solo acento: rojo
      de prioridad #B3001B. Libre Franklin para titulares y rótulos en caja
      alta, Literata para lectura larga, JetBrains Mono solo para hora, dato y
      código. Escalera de prioridad como etiquetas (roja maciza / contorno rojo
      / neutra), reglas tipográficas dobles, línea de servicio en cada página.
      STORY: El lector ve qué ha cambiado hoy en IA, entiende por qué le
      afecta, y llega a la fuente original en un clic sabiendo que lo redactó
      una máquina.
      FIRST VIEWPORT: Masthead compacto con regla doble; línea de servicio con
      fecha y recuento; despacho de cabeza a un ancho dominante con su
      etiqueta, hora y fuente; a su derecha, la pila del día como índice.
      FORM: Teletipo de agencia; candidato 4 de mi lista ordenada; seed 012bfcd3.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip" href="#main">{t.skip}</a>
    <Masthead lang={lang} altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Colophon lang={lang} />
  </body>
</html>
